{
  "manifest_version": 2,
  "id": "xiaocutedog.private-chat-tool-plus",
  "version": "1.0.0",
  "name": "主动私聊工具 Plus",
  "description": "无限制的主动私聊转达工具：支持多轮来回对话、自动人称（可匿名）、发送结果反馈、对方回复自动回传提问结果。基于自然语言由 Planner/Replyer 驱动，不修改 Napcat 适配器。",
  "author": {
    "name": "xiaocutedog",
    "url": "https://github.com/xiaocutedog"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/xiaocutedog/maibot_private_chat_tool_plus"
  },
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "chat.open_session",
    "chat.get_stream_by_user_id",
    "chat.get_private_streams",
    "api.call",
    "config.get_plugin",
    "component.enable",
    "maisaka.proactive.trigger",
    "llm.generate"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "plugin_type": "extension"
}
